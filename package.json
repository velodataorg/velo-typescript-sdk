{
  "name": "@velodata/sdk",
  "version": "0.0.0",
  "description": "",
  "keywords": [
    "api",
    "crypto",
    "futures",
    "market-data",
    "options",
    "sdk",
    "spot",
    "velo"
  ],
  "homepage": "https://github.com/velodataorg/velo-typescript-sdk#readme",
  "bugs": "https://github.com/velodataorg/velo-typescript-sdk/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velodataorg/velo-typescript-sdk.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "check:package": "publint && attw --pack . --profile esm-only",
    "prepublishOnly": "bun run build && bun run check:package",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "d3-dsv": "^3.0.1",
    "luxon": "^3.7.2",
    "query-string": "^9.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@types/d3-dsv": "^3.0.7",
    "@types/luxon": "^3.7.2",
    "@types/node": "^22.18.0",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "publint": "^0.3.14",
    "tsdown": "^0.22.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.3.0"
  }
}
